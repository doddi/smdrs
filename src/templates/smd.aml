let SMD_STYLE = {
  border: "╭─╮│╯─╰│",
}

let SMD_THEME = {
  smd_bg: "#008866"
  border_normal: "#666666"
  border_active: "#00DD66"
  menu_highlight_bg: "#0000EE"
  menu_normal_bg: "#000000"
}

vstack
  text "1: " state.page
  @titled_border [ title: "SMD RS" ]
    $children
      vstack
        text "page: " state.page
        container [height: 1]
          hstack [background: SMD_THEME.smd_bg, foreground: "white"]
            expand
              padding [left: 1]
                text "(h)omepage"
            expand
              text "(r)epositories"
            expand
              text "(m)etrics"
            expand
              padding [right: 1]
                text "(q)uarantined components"
        spacer
        if state.page == "metrics"
          @metric_dashboard
        else if state.page == "quarantine"
          @quarantine_dashboard
        else if state.page == "home"
          text "home page"
        else
          text "unknown page"
        spacer

