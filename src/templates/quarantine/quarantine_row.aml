let rating = ["🟦", "🟦", "🟩", "🟩", "🟩", "🟨", "🟨", "🟨","🟧", "🟧", "🟥"]

let quarantine_menu_options = [SMD_THEME.menu_normal_bg, SMD_THEME.menu_highlight_bg]

let bg = quarantine_menu_options[0]

container [height: 2]
  hstack [background: bg]
    expand [factor: 1]
      padding [left: 1]
        text rating[threat] threat
    expand [factor: 2]
      text policy 
    expand [factor: 3]
      text quarantine_time
    expand [factor: 4]
      text component_name
    expand [factor: 2]
      padding [right: 1]
        text repository_name
